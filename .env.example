# Anthropic API key for the built-in free tier. Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: OpenAI API key for BYOK users who prefer OpenAI
OPENAI_API_KEY=sk-...

# Anthropic model to use. Default: claude-sonnet-4-6
# Options: claude-sonnet-4-6, claude-opus-4-6, claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI model to use. Default: gpt-4o
OPENAI_MODEL=gpt-4o

# Number of free analyses allowed per IP per 24 hours. Default: 3
RATE_LIMIT_FREE_TIER=3

# Set to "true" to disable rate limiting in local development
DISABLE_RATE_LIMIT=false
